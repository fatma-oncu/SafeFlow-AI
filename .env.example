# SafeFlow AI — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file: cp .env.example .env
# 2. Fill in real values in .env
# 3. NEVER commit .env — it is listed in .gitignore
#
# For local `dotnet run` (outside Docker), use .NET User Secrets instead:
#   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "<connection-string>"
#   dotnet user-secrets set "SeedSettings:AdminEmail" "admin@example.com"
#   dotnet user-secrets set "SeedSettings:AdminPassword" "<YourStrongPassword>"
# ─────────────────────────────────────────────────────────────────────────────

# SQL Server SA Password (must meet SQL Server complexity requirements)
SA_PASSWORD=<YOUR_SA_PASSWORD>

# SQL Server Product ID (Developer | Express | Standard | Enterprise)
MSSQL_PID=Developer

# ASP.NET Core Environment (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Development

# Seed admin account — used only on first startup to create the default admin user
SEED_ADMIN_EMAIL=<YOUR_ADMIN_EMAIL>
SEED_ADMIN_PASSWORD=<YOUR_ADMIN_PASSWORD>

# JWT RSA Key Pair in PEM format
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n<YOUR_RSA_PRIVATE_KEY_BASE64>\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<YOUR_RSA_PUBLIC_KEY_BASE64>\n-----END PUBLIC KEY-----"
